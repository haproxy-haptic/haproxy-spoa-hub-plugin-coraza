FROM rust:1.94-bookworm AS builder

# Install Go 1.26
COPY --from=golang:1.26-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:$PATH"

WORKDIR /build
COPY Cargo.toml Cargo.lock build.rs Makefile ./
COPY src/ ./src/
COPY go/ ./go/
COPY benches/ ./benches/
COPY resources/ ./resources/
COPY tests/ffi_test.rs ./tests/ffi_test.rs
RUN make build-backends

# Final image with hub + plugin
FROM ghcr.io/haproxy-haptic/haproxy-spoa-hub:latest
COPY --from=builder /build/target/plugin-bundle/ /etc/haproxy-spoa-hub/plugins/
